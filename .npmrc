# Make the `engines` range in package.json a hard requirement, not a warning.
# Without this, `npm install` on an unsupported Node (notably Node 23, which has
# no prebuilt better-sqlite3 binary) prints one EBADENGINE warning, keeps going,
# and dies ~60 lines later in node-gyp. With it, the install stops immediately
# and says which Node versions are supported.
engine-strict=true
