# Make the `engines` range in package.json a hard requirement, not a warning.
# The course is taught and tested on Node 22 and Node 24 only. Without this,
# npm prints one EBADENGINE warning for an unsupported Node, scrolls it away,
# and lets the learner carry on to fail later for a reason that points
# somewhere else. With it, the install stops at once and names the versions
# that work.
engine-strict=true
