# Names only. Never real values. Copy to .env for local development.
#
# `.env` is git-ignored. `npm start` and `npm run dev` read it if it is there
# (node --env-file-if-exists), so this is where every credential lives.
RESEND_API_KEY=

# The practice credential for the rotation exercise: a classic GitHub personal
# access token on your OWN account, with NO scopes ticked.
#
# Blank is a normal state — the app starts and prints
# `practice credential: not set`. Nothing here is required to run Snackboard.
#
# This is the whole point of the hardened version: there is no copy of this
# value anywhere in the source, so rotating it means editing one git-ignored
# file and restarting. Compare `src/lib/github.js` on the starter branch, where
# the token sat on line 6 and rotating it meant editing tracked code.
#
# An exported-but-empty variable counts as absent, and the real environment
# wins over this file — so `export GITHUB_TOKEN=` in a shell profile would
# shadow whatever you put here. See `optional()` in src/env.js.
GITHUB_TOKEN=
